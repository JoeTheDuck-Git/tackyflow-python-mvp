APP_NAME="Content Workflow Python"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Comma-separated accounts allowed to manage the platform-wide core Prompt Center.
PLATFORM_OWNER_EMAILS=owner@example.com
DATABASE_PATH=./data/workflows.db
# When set, workflow and material-center data are stored in PostgreSQL.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=generated-assets
AUTH_MODE=session
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# Must also be present in the Supabase Auth redirect allowlist.
PASSWORD_RESET_REDIRECT_URL=http://127.0.0.1:8000/?auth=recovery
OPPORTUNITY_PROVIDER=openai
OPPORTUNITY_SIGNAL_PROVIDER=local_manual
# legacy | knowledge_shadow | knowledge_primary
OPPORTUNITY_PIPELINE_MODE=legacy
# knowledge_shadow 以 workspace+topic 穩定分流；確認品質後逐步 5→25→50→100
OPPORTUNITY_KNOWLEDGE_ROLLOUT_PERCENT=0
CONTENT_PROVIDER=openai
WORKFLOW_AGENT_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_YOUTUBE_MAX_CANDIDATES=4
OPENAI_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# auto uses Crawl4AI when the optional dependency is installed, otherwise the
# serverless-safe HTTP crawler. Set httpx explicitly on Vercel.
KNOWLEDGE_CRAWLER=auto
OPENAI_TIMEOUT_SECONDS=90
# 製作規劃的結構化輸出較大，使用獨立逾時與受控 SDK 重試。
OPENAI_PRODUCTION_TIMEOUT_SECONDS=180
PROMPT_TEST_INPUT_USD_PER_1M=0
PROMPT_TEST_OUTPUT_USD_PER_1M=0
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_TIMEOUT_SECONDS=150
GENERATED_ASSETS_PATH=./data/generated
DAILY_GENERATION_LIMIT=30
REQUESTS_PER_MINUTE=300
# 僅在受控部署啟動時自動套用 migrations；一般建議在 release 階段手動執行。
APPLY_AI_MIGRATIONS=false
# 僅限本機 Clash fake-IP DNS；正式環境保持 false。
CRAWL4AI_ALLOW_CLASH_FAKE_IP=false
